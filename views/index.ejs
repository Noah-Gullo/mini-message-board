<html>
    <head>
        <link rel="stylesheet" href="../styles.css">
        <title>Home</title>
    </head>

    <body>
        <h1>Home</h1>
        <div id="messages">
            <% messages.map((message) => { %>
                <div class="message">
                    <p class="authorText"><%= message.user %></p>
                    <p class="messageText">"<%= message.text %>"</p>
                    <p class="dateText">Time Added: <%= message.added %> </p>
                    <form method="POST" action="/messages/<%= message.id %>" >
                        <button>Open Message</button>
                    </form>
                </div>
            <% }) %>
            <a href="/new">New Message</a>
        </div>
    </body>
</html>